{
  "name": "stallfront",
  "version": "0.1.0",
  "private": true,
  "description": "Turn product photos into a PayPal shop in minutes. AI writes the listings. Shoppers pay with PayPal, or ask their AI assistant to shop for them.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@mcp-b/global": "6.2.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "puppeteer-core": "25.17.0"
  }
}
