# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials, Sandbox toggle)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Optional: webhook ID from the sandbox app, for signature verification
PAYPAL_WEBHOOK_ID=

# Groq API key (free plan; console.groq.com > API Keys)
GROQ_API_KEY=
# Optional overrides
# GROQ_AGENT_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Public base URL of this deployment (used for PayPal return and cancel URLs)
BASE_URL=http://localhost:3000
PORT=3000

# Sandbox test buyer (fake account from PayPal Sandbox accounts; safe to publish for judges)
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=
